@prefix rml-mapping: <http://example.com/rml-mapping#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix s4bldg: <https://saref.etsi.org/saref4bldg/> .
@prefix saref: <https://saref.etsi.org/core/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .

# Mapping for airFlowSetpoint_FreshAirVentilation
rml-mapping:MappingairFlowSetpoint_FreshAirVentilation
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "example_hotel.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator '$[?(@.type=="FreshAirVentilation" && @..airFlowSetpoint)]' ;
    ] ;
    rr:subjectMap [
        rr:template "http://example.com/airFlowSetpoint_FreshAirVentilation/{id}" ;
        rr:class saref:Measurement ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate saref:relatesToProperty ;
        rr:objectMap [
            rr:parentTriplesMap rml-mapping:MappingFreshAirVentilation ;
            rr:joinCondition [
                rr:child "id" ;
                rr:parent "id" ;
            ] ;
        ] ;
    ] ;
    .

# Mapping for AmbientTemperatureSensor
rml-mapping:MappingAmbientTemperatureSensor
    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "example_hotel.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator '$[?(@.type=="AmbientTemperatureSensor")]' ;
    ] ;
    rr:subjectMap [
        rr:template "http://example.com/AmbientTemperatureSensor/{id}" ;
        rr:class s4bldg:Sensor ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate s4bldg:isContainedIn ;
        rr:objectMap [
            rr:parentTriplesMap rml-mapping:MappingHotel ;
            rr:joinCondition [
                rr:child "hasLocation.value" ;
                rr:parent "id" ;
            ] ;
        ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate saref:relatesToProperty ;
        rr:objectMap [
            rr:parentTriplesMap rml-mapping:MappingtemperatureAmb_AmbientTemperatureSensor ;
            rr:joinCondition [
                rr:child "id" ;
                rr:parent "id" ;
            ] ;
        ] ;
    ] ;
    .

