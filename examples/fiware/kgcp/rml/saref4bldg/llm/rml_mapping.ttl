    a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "example_hotel.json" ;
        rml:referenceFormulation ql:JSONPath ;
        rml:iterator '$[?(@.type=="HotelRoom")]' ;
    ] ;
    rr:subjectMap [
        rr:template "http://example.com/HotelRoom/{id}" ;
